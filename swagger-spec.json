  "info": {
    "title": "PulgaShop - Microservicio Envíos",
    "description": "API para direcciones y transportistas",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CrearUsuarioDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "apellido": {
            "type": "string"
          },
          "correo": {
            "type": "string"
          },
          "contrasena": {
            "type": "string"
          }
        },
        "required": [
          "nombre",
          "apellido",
          "correo",
          "contrasena"
        ]
      },
      "ActualizarUsuarioDto": {
        "type": "object",
        "properties": {}
      },
      "CrearDireccionDto": {
        "type": "object",
        "properties": {
          "calle": {
            "type": "string"
          },
          "numero": {
            "type": "string"
          },
          "comuna_id": {
            "type": "string"
          },
          "codigo_comuna": {
            "type": "string",
            "description": "Código Chilexpress"
          },
          "provincia": {
            "type": "string"
          },
          "region_id": {
            "type": "string"
          },
          "codigo_postal": {
            "type": "string"
          },
          "referencias": {
            "type": "string"
          },
          "usuario_id": {
            "type": "string"
          }
        },
        "required": [
          "calle",
          "numero",
          "comuna_id",
          "region_id",
          "usuario_id"
        ]
      },
      "ActualizarDireccionDto": {
        "type": "object",
        "properties": {
          "calle": {
            "type": "string"
          },
          "numero": {
            "type": "string"
          },
          "comuna_id": {
            "type": "string"
          },
          "codigo_comuna": {
            "type": "string",
            "description": "Código Chilexpress"
          },
          "provincia": {
            "type": "string"
          },
          "region_id": {
            "type": "string"
          },
          "codigo_postal": {
            "type": "string"
          },
          "referencias": {
            "type": "string"
          },
          "usuario_id": {
            "type": "string"
          }
        }
      },
      "InfoPaqueteDto": {
        "type": "object",
        "properties": {
          "peso": {
            "type": "string",
            "example": "2.5",
            "description": "Peso del paquete en kilogramos (separado por punto)"
          },
          "alto": {
            "type": "string",
            "example": "15",
            "description": "Alto del paquete en centímetros"
          },
          "ancho": {
            "type": "string",
            "example": "25",
            "description": "Ancho del paquete en centímetros"
          },
          "largo": {
            "type": "string",
            "example": "35",
            "description": "Largo del paquete en centímetros"
          }
        },
        "required": [
          "peso",
          "alto",
          "ancho",
          "largo"
        ]
      },
      "SolicitudCotizacionDto": {
        "type": "object",
        "properties": {
          "comuna_origen_id": {
            "type": "string",
            "example": "13101",
            "description": "Código DPA de la comuna de origen (ej: 13101 = Santiago, 05109 = Viña del Mar). Usar solo si no se envía codigo_cobertura_origen"
          },
          "comuna_destino_id": {
            "type": "string",
            "example": "05109",
            "description": "Código DPA de la comuna de destino (ej: 13101 = Santiago, 05109 = Viña del Mar). Usar solo si no se envía codigo_cobertura_destino"
          },
          "codigo_cobertura_origen": {
            "type": "string",
            "example": "STGO",
            "description": "Código de cobertura de Chilexpress para origen (obtenido desde /geo/chilexpress/coverage-areas). Tiene prioridad sobre comuna_origen_id"
          },
          "codigo_cobertura_destino": {
            "type": "string",
            "example": "VAP",
            "description": "Código de cobertura de Chilexpress para destino (obtenido desde /geo/chilexpress/coverage-areas). Tiene prioridad sobre comuna_destino_id"
          },
          "paquete": {
            "description": "Información del paquete a enviar",
            "allOf": [
              {
                "$ref": "#/components/schemas/InfoPaqueteDto"
              }
            ]
          },
          "tipo_producto": {
            "type": "number",
            "example": 3,
            "description": "Tipo de producto: 1 = Documento, 3 = Encomienda",
            "enum": [
              1,
              3
            ]
          },
          "tipo_contenido": {
            "type": "number",
            "example": 1,
            "description": "Tipo de contenido del paquete"
          },
          "valor_declarado": {
            "type": "string",
            "example": "25000",
            "description": "Valor declarado del paquete en pesos chilenos"
          },
          "tiempo_entrega": {
            "type": "number",
            "example": 0,
            "description": "Servicios de entrega: 0 = Todos, 1 = Prioritarios, 2 = No prioritarios, 3 = De devolución",
            "enum": [
              0,
              1,
              2,
              3
            ],
            "default": 0
          }
        },
        "required": [
          "paquete",
          "tipo_producto",
          "tipo_contenido",
          "valor_declarado",
          "tiempo_entrega"
        ]
      },
      "OpcionServicioDto": {
        "type": "object",
        "properties": {
          "nombre_servicio": {
            "type": "string",
            "example": "PRIORITARIO",
            "description": "Nombre del servicio de envío"
          },
          "codigo_servicio": {
            "type": "string",
            "example": "PRI",
            "description": "Código del servicio"
          },
          "valor_servicio": {
            "type": "number",
            "example": 8500,
            "description": "Costo del servicio en pesos chilenos"
          },
          "tiempo_entrega": {
            "type": "string",
            "example": "1 día hábil",
            "description": "Tiempo estimado de entrega"
          },
          "disponible": {
            "type": "boolean",
            "example": true,
            "description": "Indica si el servicio está disponible"
          }
        },
        "required": [
          "nombre_servicio",
          "codigo_servicio",
          "valor_servicio",
          "tiempo_entrega",
          "disponible"
        ]
      },
      "RespuestaCotizacionDto": {
        "type": "object",
        "properties": {
